# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun.
# Supabase > Project Settings > API Keys (veya Data API) sayfasında bulunur.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Eski projelerde "anon public" anahtarı da olur:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Sitenin yayındaki adresi (paylaşım kartları ve site haritası için). Vercel'de boş bırakılırsa
# Vercel'in verdiği adres kullanılır; alan adı alınınca buraya yazılır.
# NEXT_PUBLIC_SITE_URL=https://patilidostlar.com.tr
